# Copy to .env and fill in real values. Never commit the actual .env file.

# Required. The app fails fast at startup if this is missing --
# see api.py's lifespan handler.
GEMINI_API_KEY=

# Optional. Comma-separated list of allowed frontend origins for CORS.
# Defaults to http://localhost:5173 (Vite's default dev port) if unset.
# In production, set this to your actual deployed frontend URL(s), e.g.:
# NEUROPRICE_CORS_ORIGINS=https://neuroprice.example.com
NEUROPRICE_CORS_ORIGINS=http://localhost:5173
